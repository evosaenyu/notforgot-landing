NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=public_key
NEXT_PUBLIC_EMAILJS_PRIVATE_KEY=private_key

# Supabase — not-forgot DB (migration: supabase/migrations/*_promo_signups.sql)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe Promotion Code API id (`promo_…`) or Coupon id — auto-applies at checkout after modal signup
STRIPE_PROMO_COUPON_ID=
# Customer-facing code string from Stripe Promotion codes tab (shown at checkout modal + email)
# Example: FRASFRIEND — must match an active Stripe Promotion Code exactly
NEXT_PUBLIC_DELUXE_PROMO_CODE=FRASFRIEND
# Comma-separated ticket_tiers.tier_key values the modal promo applies to (default: general,general_admission)
PROMO_ELIGIBLE_TIER_KEYS=general,general_admission

# Set to false to hide online ticket tiers/checkout (section still shows poster + thanks)
NEXT_PUBLIC_TICKET_SALES_ENABLED=false

# Resend (ticket confirmations, promo signup, purchase alerts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=tickets@not-forgot.com
